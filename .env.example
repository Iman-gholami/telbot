# Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ENGINEER_ID=
DOCTOR_ID=
# Optional; if empty ENGINEER_ID is treated as admin
ADMIN_IDS=
# Optional allow-list of chats, comma-separated. Empty = all chats
ALLOWED_CHAT_IDS=

# OpenRouter
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
# Optional preferred free models. Empty = auto-discover free text models.
AI_MODELS=
AI_TIMEOUT_SECONDS=45
DAILY_AI_LIMIT=120
DIRECT_RESERVE=20

# Paid fallback: only used after free routes fail and while monthly cap remains
PAID_FALLBACK_MODEL=openai/gpt-5-nano
MONTHLY_AI_BUDGET_USD=1.00
PAID_INPUT_USD_PER_M=0.05
PAID_OUTPUT_USD_PER_M=0.40

# Web search for freshness-sensitive questions
WEB_SEARCH_ENABLED=true
WEB_SEARCH_ENGINE=parallel
WEB_SEARCH_ESTIMATED_COST_USD=0.001

# Personality / activity
DOCTOR_BIAS=0.65
ROAST_LEVEL=2
AUTO_COOLDOWN_SECONDS=110
AUTO_MAX_PROB=0.38
AUTO_DEBOUNCE_SECONDS=8
DIRECT_FOLLOWUP_SECONDS=7

# Context & memory
HISTORY_SIZE=32
DB_HISTORY_LIMIT=350
DIGEST_EVERY=28
DIGEST_IDLE_SECONDS=90
DATA_DIR=data
