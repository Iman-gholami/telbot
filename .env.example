# Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# OpenRouter - free router by default
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
AI_MODELS=openrouter/free

# Telegram numeric user IDs
ENGINEER_ID=
DOCTOR_ID=

# Personality
DOCTOR_BIAS=0.90

# Persistent short-term context
HISTORY_SIZE=28
DB_HISTORY_LIMIT=180
DATA_DIR=data

# Automatic intervention
AUTO_COOLDOWN_SECONDS=70
AUTO_MAX_PROB=0.62
