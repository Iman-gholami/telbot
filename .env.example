# Telegram
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
ENGINEER_ID=
DOCTOR_ID=
# Optional; if empty ENGINEER_ID is treated as admin
ADMIN_IDS=
# Optional allow-list of chats, comma-separated. Empty = all chats
ALLOWED_CHAT_IDS=

# OpenRouter
OPENROUTER_API_KEY=PASTE_OPENROUTER_API_KEY_HERE
# Leave empty to auto-discover several free text models.
# If you set models manually, only :free routes are accepted.
AI_MODELS=
AI_TIMEOUT_SECONDS=45
DAILY_AI_LIMIT=120
DIRECT_RESERVE=20

# Free-only mode is hard-locked in code:
# - no paid fallback
# - no paid OpenRouter web search

# Personality / activity
DOCTOR_BIAS=0.65
ROAST_LEVEL=2
AUTO_COOLDOWN_SECONDS=110
AUTO_MAX_PROB=0.38
AUTO_DEBOUNCE_SECONDS=8
DIRECT_FOLLOWUP_SECONDS=7

# Context & smart memory
HISTORY_SIZE=32
DB_HISTORY_LIMIT=350
DIGEST_EVERY=28
DIGEST_IDLE_SECONDS=90
DATA_DIR=data
